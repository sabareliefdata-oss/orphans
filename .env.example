# Server Port
PORT=5000

# MongoDB Atlas Connection String (Leave empty to use local data/database.json)
# Example: mongodb+srv://username:password@cluster0.mongodb.net/one_nation?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for Encrypted Authentication
JWT_SECRET=one_nation_super_secure_secret_key_2026_change_me

# Default Admin (Translator) Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Default Reviewer Account
REVIEWER_USERNAME=reviewer
REVIEWER_PASSWORD=reviewer123
